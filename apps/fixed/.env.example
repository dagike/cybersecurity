# Fixed app — environment variables.
# Copy to .env for local development. In production these are set on the
# Vercel project. This project must never share any value with the vulnerable
# app: its own Neon project, its own everything.

# Pooled connection string for the fixed app's OWN isolated Neon project.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Rate limiting is backed by this same database (the rate_limits table), so no
# external cache service is needed. NODE_ENV / VERCEL_ENV are set by Vercel;
# the strict Content-Security-Policy is applied only when they indicate
# production.
