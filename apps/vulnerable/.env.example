# Vulnerable app — environment variables.
# Copy to .env for local development. In production these are set on the
# Vercel project. This project must never share any value with the fixed app.

# Pooled connection string for the vulnerable app's OWN isolated Neon project.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Master switch. The app returns 503 for everything unless this is exactly "true".
ENABLE_VULN_MODE=false

# Shared password for the demo access gate, and the secret used to sign the
# access cookie. Pick long random values.
DEMO_ACCESS_PASSWORD=change-me
GATE_COOKIE_SECRET=change-me-long-random

# Bearer token Vercel Cron sends to /api/admin/reseed. Set the same value as
# the Vercel project's CRON_SECRET.
CRON_SECRET=change-me-long-random

# Upstash Redis REST credentials for this project's OWN isolated database.
# Leave unset locally to skip edge rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
